# Chave de API do Google AI Studio (obrigatória para execução com o LLM real)
GEMINI_API_KEY=sua_chave_aqui

# Modelo Gemini utilizado pelo agente (ex.: gemini-3.8-flash ou gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Data de referência para cálculo determinístico de prazos de troca/devolução nos pedidos do CSV
REFERENCE_DATE=2026-03-25

# Integração Opcional com a API v2 do Melhor Envio (/api/v2/me/shipment/calculate)
# Se vazio, o sistema utiliza automaticamente o simulador determinístico de contingência da loja.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=false
MELHOR_ENVIO_USER_AGENT=EmporioDaMusicaAI (contato@emporiodamusica.com.br)
STORE_ORIGIN_CEP=79002070
